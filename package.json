{
    "name": "snippetly",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.21.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "generate": "ts-node -r tsconfig-paths/register scripts/generate.ts",
        "dev:server-common": "concurrently 'pnpm run --filter @snippetly/common dev' 'pnpm run --filter @snippetly/server dev'",
        "build:server": "pnpm run --filter @snippetly/server build"
    },
    "dependencies": {
        "concurrently": "catalog:tooling",
        "zod": "catalog:",
        "sql.js": "^1.14.1"
    },
    "devDependencies": {
        "@snippetly/common": "workspace:*",
        "@snippetly/server": "workspace:*",
        "@snippetly/tsconfig": "workspace:*",
        "@types/node": "catalog:tooling",
        "prettier": "catalog:tooling",
        "prettier-plugin-organize-imports": "^4.1.0",
        "ts-node": "catalog:tooling",
        "tsconfig-paths": "catalog:tooling",
        "typescript": "catalog:tooling",
        "concurrently": "catalog:tooling"
    }
}
