{
    "files.watcherExclude": {
        "**/routeTree.gen.ts": true
    },
    "search.exclude": {
        "**/routeTree.gen.ts": true
    },
    "files.readonlyInclude": {
        "**/routeTree.gen.ts": true
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "conventionalCommits.scopes": [
        "server",
        "client",
        "common",
        "eslint-config",
        "tsconfig",
        "testing",
        "repo"
    ],
    "cSpell.words": ["JWTOKEN", "snippetly", "Unstar", "virtuals"]
}
