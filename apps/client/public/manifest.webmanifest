{
    "name": "Snippetly",
    "short_name": "Snippetly",
    "description": "Share and manage code snippets",
    "start_url": "/",
    "scope": "/",
    "display_override": ["window-controls-overlay", "standalone"],
    "background_color": "#0b1220",
    "theme_color": "#0f172a",
    "icons": [
        { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" },
        {
            "src": "web-app-manifest-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "web-app-manifest-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "masked-icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "maskable any"
        }
    ],
    "screenshots": [
        {
            "src": "screenshots/narrow-screen.png",
            "type": "image/png",
            "label": "mobile view of the offline code snippets library",
            "form_factor": "narrow",
            "sizes": "360x780"
        },
        {
            "src": "screenshots/wide-screen.png",
            "type": "image/png",
            "label": "desktop view offline code snippets library",
            "form_factor": "wide",
            "sizes": "1920x994"
        }
    ]
}
