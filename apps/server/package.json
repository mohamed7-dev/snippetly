{
    "name": "@snippetly/server",
    "version": "0.0.0",
    "description": "the server side api of the snippetly application.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "db:migration": "ts-node ./scripts/migrate-db.ts",
        "db:migration:generate": "NODE_ENV=production pnpm run db:migration generate InitializeDbSchema",
        "db:migration:run": "NODE_ENV=production pnpm run db:migration run",
        "db:migration:revert": "NODE_ENV=production pnpm run db:migration revert",
        "build": "rm -rf dist && tsc --project ./tsconfig.build.json",
        "start": "NODE_ENV=production node --env-file=.env.production --env-file=.env ./dist/main.js",
        "watch:ts": "nodemon --config ./nodemon.json",
        "watch:assets": "ts-node ./scripts/watch-assets --watch",
        "dev": "concurrently 'pnpm run watch:ts' 'pnpm run watch:assets'",
        "lint": "eslint .",
        "format": "prettier",
        "check": "prettier --write . && eslint --fix",
        "test": "vitest --config vitest.config.mts --run",
        "e2e": "E2E_DB=postgres E2E_POSTGRES_PORT=5432 vitest --config ../../e2e-common/vitest.config.mts --run"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.1.0",
        "@neondatabase/serverless": "^1.0.1",
        "@snippetly/common": "workspace:*",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cookie-session": "^2.1.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "google-auth-library": "^11.1.0",
        "http-status-codes": "^2.3.0",
        "i18next": "^24.2.3",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-middleware": "^3.7.2",
        "i18next-icu": "^2.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "multer": "^2.0.2",
        "nanoid": "^5.1.11",
        "pg": "catalog:backend",
        "picocolors": "^1.1.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "catalog:backend",
        "uploadthing": "^7.7.4",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@snippetly/eslint-config": "workspace:*",
        "@snippetly/testing": "workspace:*",
        "@snippetly/tsconfig": "workspace:*",
        "@testcontainers/postgresql": "^11.10.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cookie-session": "^2.0.49",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^0.7.34",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^7.0.1",
        "@types/pg": "catalog:backend",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "chokidar": "^5.0.0",
        "concurrently": "catalog:tooling",
        "eslint": "catalog:tooling",
        "nodemailer": "^7.0.6",
        "nodemon": "^3.1.14",
        "supertest": "^7.1.4",
        "testcontainers": "^11.10.0",
        "ts-node": "catalog:tooling",
        "tsconfig-paths": "catalog:tooling",
        "typescript": "catalog:tooling",
        "vitest": "catalog:testing"
    }
}
