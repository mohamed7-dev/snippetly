{
    "name": "@snippetly/server",
    "version": "1.0.0",
    "description": "the server side api of the snippetly application.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc --project ./tsconfig.build.json",
        "start": "NODE_ENV=production node --env-file=.env.production --env-file=.env ./dist/main.js",
        "watch:tsc": "tsc --project ./tsconfig.build.json --watch",
        "dev": "nodemon ./src/index.ts",
        "lint": "eslint .",
        "format": "prettier",
        "check": "prettier --write . && eslint --fix",
        "test": "vitest"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.1.0",
        "@neondatabase/serverless": "^1.0.1",
        "@snippetly/common": "workspace:*",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cookie-session": "^2.1.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "http-status-codes": "^2.3.0",
        "i18next": "^24.2.3",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-middleware": "^3.7.2",
        "i18next-icu": "^2.3.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "multer": "^2.0.2",
        "nanoid": "^5.1.11",
        "pg": "^8.16.3",
        "picocolors": "^1.1.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.28",
        "uploadthing": "^7.7.4",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@snippetly/eslint-config": "workspace:*",
        "@snippetly/tsconfig": "workspace:*",
        "@testcontainers/postgresql": "^11.10.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cookie-session": "^2.0.49",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^0.7.34",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^7.0.1",
        "@types/pg": "^8.15.6",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.39.1",
        "globals": "^16.5.0",
        "nodemailer": "^7.0.6",
        "nodemon": "^3.1.14",
        "supertest": "^7.1.4",
        "testcontainers": "^11.10.0",
        "tsx": "^4.20.3",
        "typescript": "^5.9.2"
    }
}
