{
    "version": 2,
    "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
    "builds": [
        {
            "src": "dist/vercel.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/vercel.mjs"
        }
    ]
}
