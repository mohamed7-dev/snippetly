{
  "name": "@snippetly/server",
  "version": "1.0.0",
  "description": "the server side api of the snippetly application.",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc --project ./tsconfig.build.json",
    "start": "NODE_ENV=production node --env-file=.env.production --env-file=.env ./dist/index.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.json --env-file=.env.development --env-file=.env src/index.ts",
    "db:generate": "npx drizzle-kit generate --config=./src/config/drizzle.config.ts",
    "db:push": "npx drizzle-kit push --config=./src/config/drizzle.config.ts",
    "db:studio": "npx drizzle-kit studio --config=./src/config/drizzle.config.ts",
    "db:drop": "npx drizzle-kit drop --config=./src/config/drizzle.config.ts",
    "db:seed": "tsx --tsconfig ./tsconfig.json --env-file=.env.local src/common/db/seed.ts",
    "lint": "eslint .",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix"
  },
  "keywords": [],
  "author": "mohamed shaban",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@neondatabase/serverless": "^1.0.1",
    "@snippetly/common": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "esbuild": "^0.25.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "picocolors": "^1.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.1.5",
    "zod-openapi": "^5.4.5"
  },
  "devDependencies": {
    "@snippetly/eslint-config": "workspace:*",
    "@snippetly/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
