{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../lib",
    "noEmit": false,
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "skipLibCheck": true
  },
  "include": ["../src/**/*.ts"],
  "exclude": ["../**/*.test.ts"]
}
