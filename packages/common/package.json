{
  "name": "@snippetly/common",
  "version": "1.0.0",
  "description": "",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
"exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./dto": {
      "import": "./lib/dto/index.js",
      "types": "./lib/dto/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "dto": ["./lib/dto/index.d.ts"],
